# DeepSeek API 配置（必填）
# 优先级：环境变量 > 本文件 > ~/.dsh/.credentials.yaml
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 可选：接口基址（默认官方地址）
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# 可选：模型选择
# 对话主模型（默认 deepseek-flash）
# DEEPSEEK_MODEL=deepseek-flash
# 投研分析模型（默认 deepseek-v4-pro）
# DEEPSEEK_ANALYST_MODEL=deepseek-v4-pro

# 可选：行情数据源，eastmoney（默认，可用）| antfortune（支付宝蚂蚁财富）
# FUND_PROVIDER=eastmoney

# 可选：服务端口
# PORT=5399

# 可选：每日推送定时任务（分 时 * * 周几），默认工作日 14:10
# PUSH_CRON=10 14 * * 1-5

# 可选：行情缓存时间（毫秒）
# QUOTE_TTL_MS=20000

# ── 持久化存储（可选，但云平台强烈建议配置）────────────────────
# 云平台（Render 免费实例等）的文件系统是临时的，休眠唤醒/重新部署会清空 data/，
# 导致每日推送报告、AI 对话历史、自选基金、知识库全部丢失。
# 配置 Turso（SQLite 云，免费额度充足）即可跨重启保留。
# 获取方式见 README「十、数据持久化」。
# TURSO_URL=libsql://your-db-your-org.turso.io
# TURSO_TOKEN=eyJhbGciOi...
